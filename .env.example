# Copy to .env.local. Keep credentials out of source control.
# Fixed destination for website requests.
CONTACT_TO=contact@echoframe.co
# Use a sender authorised by your email service.
CONTACT_FROM=
APP_SECRET=

# Option A: Resend (requires a verified sending domain).
RESEND_API_KEY=

# Option B: SendGrid (requires a verified sender or authenticated domain).
SENDGRID_API_KEY=

# Option C: authenticated SMTP with TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls or ssl; plaintext SMTP is intentionally unsupported.
SMTP_SECURITY=starttls

# Optional explicit public origin, e.g. https://echoframe.co
PUBLIC_ORIGIN=
